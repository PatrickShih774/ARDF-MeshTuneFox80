# Gerber 目录整体标记（目录内的全部文件）
hardware/**/gerber/** binary -diff
hardware/**/Gerber/** binary -diff
*.gbr   binary -diff
*.gbl   binary -diff
*.gtl   binary -diff
*.gbs   binary -diff
*.gts   binary -diff
*.gbo   binary -diff
*.gto   binary -diff
*.drl   binary -diff
*.nc    binary -diff

