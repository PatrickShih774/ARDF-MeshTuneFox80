# =============================================================================
# ARDF-MeshTuneFox80  —  仓库忽略规则（公开仓）
# 目录与文件归属约定见 docs/02-repository-layout.md
# 固件源码位于私有仓 ARDF-MeshTuneFox80-firmware，本仓不含固件源码
# =============================================================================

# -----------------------------------------------------------------------------
# 〇、🔴 防泄漏护栏：固件源码严禁进入本公开仓
# -----------------------------------------------------------------------------
# 固件源码在私有仓 ARDF-MeshTuneFox80-firmware（见 LICENSING.md、ADR-0007）。
# 以下规则是"最后一道保险"：万一误把固件内容复制到本仓目录，git 也不会收进来。
# 注意：这只是兜底，真正的隔离靠"两个独立工作目录"（见 CONTRIBUTING.md 安全红线）。
software/firmware/
firmware/
**/components/*/src/*.c
**/components/*/include/*.h
main/app_main.c
sdkconfig
sdkconfig.defaults
partitions.csv

# 第三方参考设计一律不入库 —— ATU-100 等上游**无许可**，见 hardware/reference/README.md §2.1
hardware/reference/**/*.c
hardware/reference/**/*.h
hardware/reference/**/*.ino
hardware/reference/**/*.asm
hardware/reference/**/*.zip
hardware/reference/**/*.pdf

# -----------------------------------------------------------------------------
# 一、通用构建产物
# -----------------------------------------------------------------------------
# 说明：固件构建在私有仓进行，本仓不应出现 ESP-IDF 产物；保留这些规则以防误建。
build/
managed_components/
dependencies.lock
compile_commands.json
flasher_args.json
flash_args
*.elf
*.map
# 二进制不入 Git —— 固件二进制通过 GitHub Releases 分发，不提交到版本库
*.bin
*.hex
!hardware/**/*.hex

# -----------------------------------------------------------------------------
# 二、操作系统与编辑器
# -----------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/tasks.json.example

# -----------------------------------------------------------------------------
# 三、Python（中控 PC 软件、scripts、工具）
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/*.whl

# -----------------------------------------------------------------------------
# 四、EDA / 结构设计中间产物
# -----------------------------------------------------------------------------
*-backups/
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache
*.lck
*.autosave
*.bak
*.dwl
*.dwl2
# 立创EDA / EasyEDA 自动备份
*.epro
*.zip.lck

# -----------------------------------------------------------------------------
# 五、测试与测量原始数据（体积大，用外部归档并对归档登记哈希）
# -----------------------------------------------------------------------------
validation/**/raw/
validation/**/*.csv.gz
validation/**/*.npy
validation/**/*.s2p
validation/**/*.s1p

# -----------------------------------------------------------------------------
# 六、密钥与个人信息（严禁入库）
# -----------------------------------------------------------------------------
*.pem
*.key
secrets/
*.secret
mesh_keys/
sdkconfig.local

# -----------------------------------------------------------------------------
# 七、CI / 临时目录
# -----------------------------------------------------------------------------
.cache/
tmp/
.tmp/
out/
